# Create an API app at https://www.strava.com/settings/api
# Authorization Callback Domain: your host only (e.g. localhost or nas.example.com)
# Redirect URI used by this app: https://<host>/api/strava/callback

NUXT_PUBLIC_STRAVA_CLIENT_ID=
NUXT_STRAVA_CLIENT_SECRET=

# Optional if reverse-proxy origin detection is wrong:
# NUXT_STRAVA_REDIRECT_URI=https://nas.example.com/api/strava/callback
